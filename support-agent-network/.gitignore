# models/

# Logs and run outputs (ignore general logs but commit sample output deliverables)
logs/*
!logs/.gitkeep
!logs/run_20260802T103458Z.jsonl
outputs/*
!outputs/.gitkeep
!outputs/sample_run_*.json


