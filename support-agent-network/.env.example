# .env.example — copy to .env and fill in values
# NEVER put real secrets in this file or commit .env to source control

# ── Local model paths (optional overrides) ───────────────────────────────────
# Default: HuggingFace standard cache (~/.cache/huggingface/hub)
# HF_HOME=/path/to/custom/hf/cache

# ── Offline enforcement ──────────────────────────────────────────────────────
# Set to 1 after first model download to prevent any network calls at runtime
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=./logs
# LOG_LEVEL=INFO

# ── Generation tuning ────────────────────────────────────────────────────────
# MAX_NEW_TOKENS=512
# MAX_ATTEMPTS=2
# RETRIEVAL_THRESHOLD=0.35
